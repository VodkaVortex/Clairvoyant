     7	
     8	/***********************************************************************
     9	 * Device probing and disconnecting
    10	 ***********************************************************************/
    11	
    12	/* Associate our private data with the USB device */
    13	static int associate_dev(struct us_data *us, struct usb_interface *intf)
    14	{
    15		/* Fill in the device-related fields */
    16		us->pusb_dev = interface_to_usbdev(intf);
    17		us->pusb_intf = intf;
    18		us->ifnum = intf->cur_altsetting->desc.bInterfaceNumber;
    19		usb_stor_dbg(us, "Vendor: 0x%04x, Product: 0x%04x, Revision: 0x%04x\n",
    20			     le16_to_cpu(us->pusb_dev->descriptor.idVendor),
    21			     le16_to_cpu(us->pusb_dev->descriptor.idProduct),
    22			     le16_to_cpu(us->pusb_dev->descriptor.bcdDevice));
    23		usb_stor_dbg(us, "Interface Subclass: 0x%02x, Protocol: 0x%02x\n",
    24			     intf->cur_altsetting->desc.bInterfaceSubClass,
    25			     intf->cur_altsetting->desc.bInterfaceProtocol);
    26	
    27		/* Store our private data in the interface */
    28		usb_set_intfdata(intf, us);
    29	
    30		/* Allocate the control/setup and DMA-mapped buffers */
    31		us->cr = kmalloc_obj(*us->cr);
    32		if (!us->cr)
    33			return -ENOMEM;
    34	
    35		us->iobuf = usb_alloc_coherent(us->pusb_dev, US_IOBUF_SIZE,
    36				GFP_KERNEL, &us->iobuf_dma);
